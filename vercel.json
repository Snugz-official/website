{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/(extension|supabase|Resources)/:path*", "destination": "/", "permanent": false },
    { "source": "/(extension|supabase|Resources)", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/website/index.html" },
    { "source": "/((?!website/).*)", "destination": "/website/$1" }
  ]
}
